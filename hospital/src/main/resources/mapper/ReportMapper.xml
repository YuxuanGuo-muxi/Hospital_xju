    <select id="getQuery" resultType="com.xju.hospital.entity.Report">
        SELECT
        r.patient_id,
        p.admission_number,
        r.*,
        DATEDIFF(r.next_time, CURRENT_DATE) AS days_until_next_time
        FROM
        patient AS p
        JOIN
        reports AS r
        ON
        p.admission_number = r.patient_id
        WHERE
        DATEDIFF(r.next_time, CURRENT_DATE) &lt;= 7 AND r.next_time>=CURRENT_DATE
        ORDER BY
        r.next_time;
    </select>
    <select id="queryAll" resultType="com.xju.hospital.entity.Report">
        SELECT p.doctor_id, p.patient_id, r.*
        FROM patient AS p
        JOIN reports AS r ON p.patient_id = r.patient_id
        limit #{offset},#{limit}
    </select>
