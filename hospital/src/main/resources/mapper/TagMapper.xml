<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xju.hospital.mapper.TagMapper">
    <insert id="add">
        insert into tags(tag_id,tag_name,tag_description) values(#{tag.tagId},#{tag.tagName},#{tag.tagDescription})
    </insert>
    <delete id="deleteTags">
        delete from patient_tags where patient_id = #{patientId}
    </delete>
    <select id="getTags" resultType="java.lang.String">
        select t.tag_name from tags as t,patient_tags as pt where pt.tag_id = t.tag_id and pt.patient_id = #{patientId};
    </select>
    <select id="getAll" resultType="com.xju.hospital.entity.Tag">
        select * from tags where is_disabled = 0
    </select>
    <select id="getTagNames" resultType="java.lang.String">
        select tag_name from tags limit 5
    </select>
    <select id="getTagsLimit" resultType="com.xju.hospital.entity.Tag">
        select * from tags where is_disabled = 0 limit #{offset},#{limit}
    </select>
    <delete id="deleteById">
        delete from tags where tag_id = #{tagId}
    </delete>
    <select id="checkIdExists" resultType="int" parameterType="String">
        SELECT COUNT(*) FROM tags WHERE tag_id = #{tagId}
    </select>
</mapper>

